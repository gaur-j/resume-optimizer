# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---
# Public key id (used by the browser checkout AND the server).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# SERVER ONLY
RAZORPAY_SECRET=
# SERVER ONLY. Different from RAZORPAY_SECRET (from Dashboard > Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# --- LLM providers (SERVER ONLY) ---
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Free-check IP handoff (SERVER ONLY, 32+ characters) ---
# Only needed if a separate front end forwards visitor IPs. See IP_PROXY_SETUP.md.
RESUME_PROXY_SECRET=

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# SERVER ONLY
GA_API_SECRET=

# --- Monitoring (optional, SERVER ONLY) ---
ERROR_WEBHOOK_URL=

# --- Optional switches ---
# Set to true to enforce the full Content-Security-Policy (default: report-only).
CSP_ENFORCE=
# Comma-separated LAN IPs for testing the dev server from a phone, e.g. 192.168.1.20
DEV_ALLOWED_ORIGINS=